# Copia este archivo a .env (nunca subas .env al repositorio)
#   cp .env.example .env

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave "anon" / "publishable" (es pública por diseño; la protege RLS).
# NUNCA uses aquí la service_role key.
VITE_SUPABASE_ANON_KEY=eyJ...

# Looker Studio → Archivo → Insertar informe → Habilitar incrustación → copiar la URL del src del iframe
# Formato: https://lookerstudio.google.com/embed/reporting/<ID>/page/<PAGINA>
VITE_LOOKER_EMBED_URL=
